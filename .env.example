# ───────────────────────────────────────────────────────────────
# Solo variables de INFRAESTRUCTURA. Las credenciales de Wompi, Siigo,
# AUCO, Google y Microsoft se administran desde el panel SUPER ADMIN
# (Integraciones) y se guardan cifradas en la base de datos.
# ───────────────────────────────────────────────────────────────

# Dominio raíz de la plataforma. Subdominios: {tenant}.sst.zark.pro,
# admin.sst.zark.pro (SUPER ADMIN) y auth.sst.zark.pro (OAuth central).
NEXT_PUBLIC_ROOT_DOMAIN=sst.zark.pro
# En local: usar lvh.me (resuelve *.lvh.me a 127.0.0.1) y puerto.
# NEXT_PUBLIC_ROOT_DOMAIN=lvh.me:3000

# PostgreSQL (Neon). En Vercel lo inyecta la integración de Neon (DATABASE_URL y DATABASE_URL_UNPOOLED).
# Rol propietario; la app cambia a app_tenant/app_platform por transacción.
DATABASE_URL=postgres://user:pass@host/db?sslmode=require
DATABASE_URL_UNPOOLED=
# Solo tests (Postgres local o servicio de CI).
TEST_DATABASE_URL=postgres://sst_owner:sst_owner@localhost:5432/sst_test

# Llave maestra de cifrado (32 bytes en base64): openssl rand -base64 32
ENCRYPTION_MASTER_KEY=
# Llave para blind index (HMAC) de campos buscables: openssl rand -base64 32
BLIND_INDEX_KEY=

# Better Auth
AUTH_SECRET=

# SUPER ADMIN inicial (seed). Cambiar la contraseña en el primer ingreso y activar 2FA.
SUPER_ADMIN_EMAIL=
SUPER_ADMIN_PASSWORD=

# Vercel Blob
BLOB_READ_WRITE_TOKEN=

# Resend (correo transaccional y magic links)
RESEND_API_KEY=
MAIL_FROM="SST <no-reply@sst.zark.pro>"

# API de Vercel para dominios personalizados de las empresas
VERCEL_API_TOKEN=
VERCEL_PROJECT_ID=
VERCEL_TEAM_ID=

# Cola de trabajos (Inngest)
INNGEST_EVENT_KEY=
INNGEST_SIGNING_KEY=

# Cron de Vercel (Authorization: Bearer ...)
CRON_SECRET=

# Observabilidad
SENTRY_DSN=

# Notificaciones push (PWA). Generar con: npx web-push generate-vapid-keys
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:soporte@sst.zark.pro
